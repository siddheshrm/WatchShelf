RewriteEngine On

# --------------------------------------------------
# Production URL normalization
# --------------------------------------------------

# Redirect www.watchshelf.in to watchshelf.in

RewriteCond %{HTTP_HOST} ^www\.watchshelf\.in$ [NC]
RewriteRule ^(.*)$ https://watchshelf.in/$1 [R=301,L]

# Redirect HTTP to HTTPS

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?watchshelf\.in$ [NC]
RewriteRule ^(.*)$ https://watchshelf.in/$1 [R=301,L]

# Redirect /index.php to /
# Preserve query parameters such as ?quick_link=...

RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

# --------------------------------------------------
# Sitemap
# --------------------------------------------------

# Redirect direct access to sitemap.xml.php to the public sitemap URL.

RewriteCond %{THE_REQUEST} \s/+sitemap\.xml\.php(?:[?\s]) [NC]
RewriteRule ^sitemap\.xml\.php$ /sitemap.xml [R=301,L]

# Internally serve sitemap.xml.php when sitemap.xml is requested.

RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]

# --------------------------------------------------
# Watch product URLs
# --------------------------------------------------

# Internally rewrite clean product URLs:
# /watch/sonata-festive-quartz-analog-with-date-320
# → /watch/details.php?id=320&slug=sonata-festive-quartz-analog-with-date

RewriteRule ^watch/(.+)-([0-9]+)$ watch/details.php?id=$2&slug=$1 [L,QSA]

# --------------------------------------------------
# Do not rewrite existing files/directories
# --------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------------
# Restrict .env from downloading
# --------------------------------------------------

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>